# Google Identity Services web client ID (allow the Studio origin in Google Cloud).
VITE_WRISTO_GOOGLE_CLIENT_ID=

# Public Paddle client-side token; never put API keys or webhook secrets here.
# Credit packages and the dedicated webhook are configured on wristo-api.
VITE_WRISTO_PADDLE_ENVIRONMENT=sandbox
VITE_WRISTO_PADDLE_CLIENT_TOKEN=
