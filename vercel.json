{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.garminface.com/api/$1"
    },
    {
      "source": "/wristo-api/(.*)",
      "destination": "https://api.wristo.io/api/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/guides/create-garmin-watch-face",
      "destination": "/guides/create-garmin-watch-face/index.html"
    },
    {
      "source": "/guides/install-garmin-watch-face",
      "destination": "/guides/install-garmin-watch-face/index.html"
    },
    {
      "source": "/:app(auth|faces|tokens|moon|prg-installer|create-watch-face|wiki|academy|data-catalog-unavailable|design|designs|fonts|number-font-library|icon-library|weather-font-library|icon-assets|FAQ|devices|tickets|meter|profile|design-unlocks|design-slots|credits|pricing|packaging-logs)/:path*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://*.garminface.com/"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
